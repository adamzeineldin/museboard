# Copy to .env and fill in. Never commit .env.

# SQLite "file:" URL (path is relative to the repo root). Postgres is not supported yet.
DATABASE_URL="file:./dev.db"

# Auth.js. Generate a secret with: openssl rand -base64 33   and paste it here. Keep it in .env, not
# .env.local: the worker, seed and token scripts read only .env.
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Magic-link email. Leave EMAIL_SERVER empty in local dev: the link is printed to the server
# console and written to .dev-mail/last-link.txt instead.
# Example: smtp://user:password@smtp.example.com:587
EMAIL_SERVER=""
EMAIL_FROM="Inroad <no-reply@inroad.local>"

# Public base URL of the app (used in emails and the Muse connector).
APP_URL="http://localhost:3000"

# Only for test deployments running `next start` without SMTP: allow the .dev-mail fallback.
# INROAD_DEV_MAIL="1"

# Python 3.11+ executable the worker runs the scraper with (default: python3).
# INROAD_PYTHON="python3.12"

# Match-score embedder. Only "local" (the default) is supported.
# INROAD_EMBEDDER="local"
